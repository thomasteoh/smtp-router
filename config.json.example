{
  "providers": [
    {
      "name": "smtp-harmonicr",
      "type": "smtp",
      "host": "smtp.example.com",
      "port": 587,
      "auth": "user:password",
      "starttls": true
    },
    {
      "name": "api-provider",
      "type": "api",
      "url": "https://api.example.com/send",
      "token": "provider-api-token",
      "method": "POST"
    }
  ],
  "accounts": {
    "alerts@harmonicr.com": {
      "from": "alerts@harmonicr.com",
      "provider": "smtp-harmonicr",
      "rate": { "day": 200, "month": 2000 }
    },
    "noreply@harmonicr.com": {
      "from": "noreply@harmonicr.com",
      "provider": "api-provider",
      "rate": { "day": 100, "month": 500 }
    },
    "billing@harmonicr.com": {
      "from": "billing@harmonicr.com",
      "allocation": [
        { "name": "smtp-harmonicr", "weight": 3 },
        { "name": "api-provider", "weight": 1 }
      ],
      "rate": { "day": 100, "month": 500 }
    }
  },
  "allowlist": ["*@harmonicr.com"],
  "denylist": ["spam@harmonicr.com"],
  "clients": {
    "billing-service": {
      "name": "billing-service",
      "key": "sha256-of-client-key",
      "note": "generated via admin add-client",
      "allowed_from": ["alerts@harmonicr.com"]
    }
  },
  "webhooks": [
    {
      "url": "https://hooks.example.com/email",
      "events": ["delivered", "rate_limited", "denied", "error"],
      "secret": "webhook-hmac-secret"
    }
  ],
  "oidc": {
    "issuer": "https://auth.harmonicr.com",
    "client_id": "smtp-router-oidc-client",
    "client_secret": "oidc-client-secret",
    "scopes": ["openid", "profile", "email", "urn:zitadel:iam:org:projects:roles"],
    "admin_role": "mail-admin",
    "redirect_url": "https://smtp.harmonicr.com/callback"
  },
  "admin_token": "admin-bearer-token",
  "default_rate": { "day": 200, "month": 2000 },
  "queue": {
    "enabled": false,
    "workers": 4,
    "batch": 8,
    "max_size": 0,
    "max_retries": 3,
    "retry_base": 30,
    "db_path": "/opt/smtp-router-data/smtp-router-queue.db"
  }
}
